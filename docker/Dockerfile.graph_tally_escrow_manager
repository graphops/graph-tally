FROM rust:1.91-bookworm AS build

WORKDIR /root

RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake libsasl2-dev protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

COPY . .

ENV CARGO_BUILD_JOBS=4

RUN rustup component add clippy \
    && cargo test --locked --package graph_tally_escrow_manager \
    && cargo clippy --locked --package graph_tally_escrow_manager --all-targets -- -D warnings \
    && cargo build --locked --release --bin graph_tally_escrow_manager

########################################################################################

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libsasl2-dev openssl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /root/target/release/graph_tally_escrow_manager /usr/local/bin/graph_tally_escrow_manager

ENTRYPOINT [ "/usr/local/bin/graph_tally_escrow_manager" ]
